<?xml version="1.0" encoding="UTF-8"?>
 
 
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>myServletFiles.RegisterServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>


    <servlet>
        <servlet-name>InputServlet</servlet-name>
        <servlet-class>myServletFiles.InputServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InputServlet</servlet-name>
        <url-pattern>/input</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GradeServlet</servlet-name>
        <servlet-class>myServletFiles.GradeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GradeServlet</servlet-name>
        <url-pattern>/grade</url-pattern>
    </servlet-mapping>
    
        <servlet>
        <servlet-name>ProductSelectionServlet</servlet-name>
        <servlet-class>myServletFiles.ProductSelectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductSelectionServlet</servlet-name>
        <url-pattern>/product</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReceiptServlet</servlet-name>
        <servlet-class>myServletFiles.ReceiptServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceiptServlet</servlet-name>
        <url-pattern>/receipt</url-pattern>
    </servlet-mapping>
    <servlet>
    <servlet-name>CartServlet</servlet-name>
    <servlet-class>myServletFiles.CartServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>CartServlet</servlet-name>
    <url-pattern>/addToCart</url-pattern>
</servlet-mapping>

<servlet-mapping>
    <servlet-name>CartServlet</servlet-name>
    <url-pattern>/viewCart</url-pattern>
</servlet-mapping>
    
    <servlet>
    <servlet-name>StudentDBServlet</servlet-name>
    <servlet-class>myServletFiles.StudentDBServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>StudentDBServlet</servlet-name>
    <url-pattern>/viewStudent</url-pattern>
</servlet-mapping>
    
    <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>myServletFiles.LoginServlet</servlet-class>
</servlet>
<servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
</servlet-mapping>
    

</web-app>


